{
  "name": "@stackline/unified-engine",
  "version": "1.0.3",
  "description": "Process files with unified plugins, configuration, and ignore rules using the unified-engine 10 callback API",
  "license": "MIT",
  "keywords": [
    "stackline",
    "npm-package",
    "unified-engine",
    "typescript",
    "nodejs",
    "unified",
    "processor",
    "engine",
    "plugins",
    "markdown",
    "configuration",
    "glob"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-unified-engine.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-unified-engine/issues"
  },
  "author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/unified"
  },
  "contributors": [
    "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
    "Christian Murphy <christian.murphy.42@gmail.com>"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "lib/",
    "index.d.ts",
    "index.js",
    "CHANGELOG.md",
    "NOTICE",
    "UPSTREAM-TYPES.md"
  ],
  "dependencies": {
    "@types/concat-stream": "npm:@stackline/types-concat-stream@1.0.0",
    "@types/debug": "^4.0.0",
    "@types/is-empty": "npm:@stackline/types-is-empty@1.0.0",
    "@types/node": "^18.0.0",
    "@types/unist": "npm:@stackline/types-unist@1.0.0",
    "concat-stream": "npm:@stackline/concat-stream@1.0.0",
    "debug": "npm:@stackline/debug@1.0.0",
    "fault": "npm:@stackline/fault@1.0.0",
    "glob": "^13.0.6",
    "ignore": "^5.0.0",
    "is-buffer": "npm:@stackline/is-buffer@1.0.0",
    "is-empty": "npm:@stackline/is-empty@1.0.0",
    "is-plain-obj": "npm:@stackline/is-plain-obj@1.0.0",
    "parse-json": "npm:@stackline/parse-json@1.0.0",
    "to-vfile": "npm:@stackline/to-vfile@1.0.0",
    "trough": "npm:@stackline/trough@1.0.0",
    "unist-util-inspect": "npm:@stackline/unist-util-inspect@1.0.0",
    "vfile-message": "npm:@stackline/vfile-message@1.0.0",
    "vfile-reporter": "npm:@stackline/vfile-reporter@1.0.0",
    "vfile-statistics": "npm:@stackline/vfile-statistics@1.0.0",
    "yaml": "^2.0.0",
    "@stackline/load-plugin": "1.0.2"
  },
  "devDependencies": {
    "remark": "npm:@stackline/remark@1.0.0",
    "strip-ansi": "^7.0.0",
    "unified": "npm:@stackline/unified@1.0.0",
    "vfile": "npm:@stackline/vfile@1.0.0",
    "vfile-reporter-json": "npm:@stackline/vfile-reporter-json@1.0.0",
    "vfile-reporter-pretty": "npm:@stackline/vfile-reporter-pretty@1.0.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "npm run test:types",
    "test": "node --conditions development test/index.js && node --test test/finder-regression.js",
    "test-api": "node --conditions development test/index.js",
    "lint": "node --check lib/finder.js",
    "prepack": "npm run build",
    "test:types": "tsc -p test/tsconfig.types.json",
    "test:package": "node scripts/test-package.mjs"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "semi": false,
    "trailingComma": "none"
  },
  "homepage": "https://alexandro.net/docs/vanilla/unified-engine/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
